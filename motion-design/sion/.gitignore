# Les photos d’archive doivent être versionnées malgré la règle globale *.jpg / *.png
!portraits/*.jpg
!portraits/*.jpeg
!portraits/*.png
stills/
cues.json
video.mp4
# Textures de relief de la carte du partage (data/relief), générées par tools/prep_partage.py
!data/relief/*.png
# Données de l’intro aérienne (data/drone, data/drone-gaza…), refaites par tools/prep_drone.py
data/drone/
data/drone-*/
# Photos d’archive en relief (photo3d.html), préparées par tools/prep_archives.py : versionnées
!data/archives/*.jpg
!data/archives/*.png
# Reconstitutions : timeline générée par tools/build_reconstitution.py, images extraites des clips
timelines/reconstitutions.js
output/reconstitution/images/

# brouillon des reconstitutions IA : remonté et poussé quand tous les clips seront là
output/reconstitutions.mp4
output/reconstitutions.wav
output/reconstitutions/

# bruitages téléchargés (catalogue : data/bruitages.json, python3 tools/banque_sons.py prendre)
data/sons/
